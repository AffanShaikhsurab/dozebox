{
  "name": "dozebox-workspace",
  "private": true,
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@12.23.0",
  "engines": {
    "node": ">=24.12"
  },
  "scripts": {
    "build": "pnpm -r --if-present build",
    "fmt": "prettier --write .",
    "fmt:check": "prettier --check .",
    "lint": "oxlint --deny-warnings && depcruise packages scripts && node scripts/check-words.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --conditions=@dozebox/source --test \"scripts/test/**/*.test.ts\" && pnpm -r --if-present test",
    "test:wire": "pnpm --filter @dozebox/control --filter @dozebox/agent test:wire",
    "sim": "pnpm --filter @dozebox/sim --if-present sim",
    "knip": "knip --no-progress",
    "check:words": "node scripts/check-words.ts",
    "check:sizes": "node scripts/check-sizes.ts",
    "check:schema": "pnpm -r --if-present check:schema",
    "test:legacy": "node --test \"legacy/runner/test/**/*.node-test.ts\"",
    "tf:test": "terraform -chdir=terraform init -backend=false -input=false && terraform -chdir=terraform test",
    "check": "pnpm fmt:check && pnpm lint && pnpm typecheck && pnpm test && pnpm check:schema && pnpm check:sizes && pnpm knip"
  },
  "devDependencies": {
    "@types/node": "26.6.7",
    "dependency-cruiser": "18.9.0",
    "knip": "6.48.0",
    "oxlint": "1.95.0",
    "prettier": "3.10.1",
    "typescript": "6.0.3",
    "yaml": "2.9.1"
  }
}
