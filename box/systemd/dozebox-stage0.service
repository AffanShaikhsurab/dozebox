[Unit]
Description=Dozebox stage 0: install the agent release, on every boot
# cloud-init's runcmd runs once per instance, and the stack stops the box right after create, so a stop during runcmd
# would lose stage 0 for the instance's whole life. This unit is enabled on every boot instead.
After=network-online.target cloud-config.service
Wants=network-online.target
Before=dozebox-boot.service

[Service]
Type=oneshot
RemainAfterExit=yes
TimeoutStartSec=15min
EnvironmentFile=/etc/dozebox/box.env
RuntimeDirectory=dozebox
RuntimeDirectoryPreserve=yes
ExecStart=/opt/dozebox/stage0/stage0.sh ${DOZEBOX_AGENT_VERSION} ${DOZEBOX_AGENT_BASE_URL} ${DOZEBOX_AGENT_SHA256}

[Install]
WantedBy=multi-user.target
