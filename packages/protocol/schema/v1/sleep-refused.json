{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dozebox.dev/schema/v1/sleep-refused.json",
  "title": "SleepRefused",
  "type": "object",
  "required": [
    "error",
    "blockers"
  ],
  "properties": {
    "error": {
      "type": "object",
      "required": [
        "code",
        "message",
        "retryable"
      ],
      "properties": {
        "code": {
          "type": "string",
          "const": "conflict"
        },
        "message": {
          "type": "string"
        },
        "retryable": {
          "type": "boolean",
          "const": false
        }
      }
    },
    "blockers": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
