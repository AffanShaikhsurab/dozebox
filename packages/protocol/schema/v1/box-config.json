{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dozebox.dev/schema/v1/box-config.json",
  "title": "BoxConfig",
  "type": "object",
  "required": [
    "schema",
    "box",
    "brand",
    "idle",
    "health",
    "failsafe",
    "caps",
    "disk",
    "alerts",
    "logs",
    "presenceSources",
    "jail",
    "tripwire",
    "payloads"
  ],
  "properties": {
    "schema": {
      "type": "number",
      "const": 1
    },
    "box": {
      "type": "object",
      "required": [
        "id",
        "prefix",
        "region"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]{0,19}$"
        },
        "prefix": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{0,20}$"
        },
        "region": {
          "type": "string",
          "pattern": "^[a-z]{2}(-[a-z]+)+-\\d$"
        }
      },
      "additionalProperties": false
    },
    "brand": {
      "type": "object",
      "required": [
        "name",
        "alertSubject"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60
        },
        "alertSubject": {
          "type": "string",
          "maxLength": 120
        }
      },
      "additionalProperties": false
    },
    "idle": {
      "type": "object",
      "required": [
        "idleMinutes",
        "viewingGraceMinutes",
        "noProgressParkMinutes"
      ],
      "properties": {
        "idleMinutes": {
          "type": "integer",
          "minimum": 5,
          "maximum": 1440
        },
        "viewingGraceMinutes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1440
        },
        "noProgressParkMinutes": {
          "type": "integer",
          "minimum": 5,
          "maximum": 10080
        }
      },
      "additionalProperties": false
    },
    "health": {
      "type": "object",
      "required": [
        "checkEverySeconds",
        "restartAtStrikes",
        "parkAtStrikes",
        "restartsPerHour"
      ],
      "properties": {
        "checkEverySeconds": {
          "type": "integer",
          "minimum": 10,
          "maximum": 3600
        },
        "restartAtStrikes": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1
          },
          "maxItems": 8
        },
        "parkAtStrikes": {
          "type": "integer",
          "minimum": 1
        },
        "restartsPerHour": {
          "type": "integer",
          "minimum": 0,
          "maximum": 60
        }
      },
      "additionalProperties": false
    },
    "failsafe": {
      "type": "object",
      "required": [
        "bootDeadlineMinutes",
        "everyMinutes"
      ],
      "properties": {
        "bootDeadlineMinutes": {
          "type": "integer",
          "minimum": 1
        },
        "everyMinutes": {
          "type": "integer",
          "minimum": 1
        }
      },
      "additionalProperties": false
    },
    "caps": {
      "type": "object",
      "required": [
        "awakeHoursPerDay"
      ],
      "properties": {
        "awakeHoursPerDay": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0,
              "maximum": 24
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "disk": {
      "type": "object",
      "required": [
        "lowPct",
        "criticalPct",
        "hysteresisPct"
      ],
      "properties": {
        "lowPct": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "criticalPct": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "hysteresisPct": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        }
      },
      "additionalProperties": false
    },
    "alerts": {
      "type": "object",
      "required": [
        "topicArn",
        "dedupeSeconds"
      ],
      "properties": {
        "topicArn": {
          "type": "string",
          "pattern": "^arn:aws[a-z-]*:sns:[a-z0-9-]+:\\d{12}:[A-Za-z0-9_-]{1,256}$"
        },
        "dedupeSeconds": {
          "type": "integer",
          "minimum": 0,
          "maximum": 86400
        }
      },
      "additionalProperties": false
    },
    "logs": {
      "type": "object",
      "required": [
        "group",
        "dailyBudgetMiB"
      ],
      "properties": {
        "group": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_/.#-]{1,512}$"
        },
        "dailyBudgetMiB": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "presenceSources": {
      "type": "object",
      "required": [
        "ssh",
        "tcpPorts"
      ],
      "properties": {
        "ssh": {
          "type": "boolean"
        },
        "tcpPorts": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1,
            "maximum": 65535
          },
          "maxItems": 8
        }
      },
      "additionalProperties": false
    },
    "jail": {
      "type": "object",
      "required": [
        "enabled",
        "egress",
        "allowHosts"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "egress": {
          "anyOf": [
            {
              "type": "string",
              "const": "imds-only"
            },
            {
              "type": "string",
              "const": "allowlist"
            },
            {
              "type": "string",
              "const": "off"
            }
          ]
        },
        "allowHosts": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 253
          },
          "maxItems": 64
        }
      },
      "additionalProperties": false
    },
    "tripwire": {
      "type": "object",
      "required": [
        "enabled"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "payloads": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9-]{0,30}$"
      },
      "maxItems": 4
    }
  },
  "additionalProperties": false
}
