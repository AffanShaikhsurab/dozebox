{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dozebox.dev/schema/v1/payload-definition.json",
  "title": "PayloadDefinition",
  "type": "object",
  "required": [
    "schema",
    "name",
    "user",
    "protocol",
    "start"
  ],
  "properties": {
    "schema": {
      "type": "number",
      "const": 1
    },
    "name": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,30}$"
    },
    "description": {
      "type": "string",
      "maxLength": 200
    },
    "user": {
      "type": "string",
      "pattern": "^(?!root$)[a-z_][a-z0-9_-]{0,31}$"
    },
    "protocol": {
      "anyOf": [
        {
          "type": "string",
          "const": "v1"
        },
        {
          "type": "string",
          "const": "none"
        }
      ]
    },
    "install": {
      "type": "object",
      "required": [
        "command",
        "when",
        "timeoutSeconds"
      ],
      "properties": {
        "command": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 4096
          },
          "minItems": 1,
          "maxItems": 64
        },
        "when": {
          "anyOf": [
            {
              "type": "string",
              "const": "every-boot"
            },
            {
              "type": "string",
              "const": "once"
            },
            {
              "type": "string",
              "const": "on-change"
            }
          ]
        },
        "timeoutSeconds": {
          "type": "integer",
          "minimum": 10,
          "maximum": 3600
        },
        "asRoot": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "start": {
      "type": "object",
      "required": [
        "command"
      ],
      "properties": {
        "command": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 4096
          },
          "minItems": 1,
          "maxItems": 64
        },
        "workingDirectory": {
          "type": "string"
        },
        "env": {
          "type": "object",
          "patternProperties": {
            "^[A-Z_][A-Z0-9_]{0,63}$": {
              "type": "string",
              "maxLength": 4096
            }
          }
        },
        "stopGraceSeconds": {
          "type": "integer",
          "minimum": 5,
          "maximum": 600
        },
        "noNewPrivileges": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "health": {
      "type": "object",
      "properties": {
        "http": {
          "type": "object",
          "required": [
            "url"
          ],
          "properties": {
            "url": {
              "type": "string",
              "pattern": "^http://(127\\.0\\.0\\.1|localhost|\\[::1\\])"
            },
            "expectStatus": {
              "type": "integer"
            }
          },
          "additionalProperties": false
        },
        "command": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 4096
          },
          "minItems": 1,
          "maxItems": 64
        },
        "timeoutSeconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 60
        },
        "startPeriodSeconds": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3600
        }
      },
      "additionalProperties": false
    },
    "activity": {
      "type": "object",
      "properties": {
        "cpuPercent": {
          "type": "number",
          "minimum": 0.5,
          "maximum": 100
        },
        "tcpPorts": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1,
            "maximum": 65535
          },
          "maxItems": 8
        }
      },
      "additionalProperties": false
    },
    "limits": {
      "type": "object",
      "properties": {
        "holdMaxSeconds": {
          "type": "integer",
          "minimum": 60,
          "maximum": 86400
        },
        "memoryMax": {
          "type": "string",
          "pattern": "^[0-9]+[KMG]$|^[0-9]{1,3}%$"
        },
        "cpuWeight": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000
        }
      },
      "additionalProperties": false
    },
    "data": {
      "type": "object",
      "properties": {
        "critical": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "maxItems": 16
        },
        "preSnapshot": {
          "type": "object",
          "required": [
            "command",
            "timeoutSeconds"
          ],
          "properties": {
            "command": {
              "type": "array",
              "items": {
                "type": "string",
                "maxLength": 4096
              },
              "minItems": 1,
              "maxItems": 64
            },
            "timeoutSeconds": {
              "type": "integer",
              "minimum": 1,
              "maximum": 3600
            }
          },
          "additionalProperties": false
        },
        "postSnapshot": {
          "type": "object",
          "required": [
            "command",
            "timeoutSeconds"
          ],
          "properties": {
            "command": {
              "type": "array",
              "items": {
                "type": "string",
                "maxLength": 4096
              },
              "minItems": 1,
              "maxItems": 64
            },
            "timeoutSeconds": {
              "type": "integer",
              "minimum": 1,
              "maximum": 3600
            }
          },
          "additionalProperties": false
        },
        "verifyRestore": {
          "type": "object",
          "required": [
            "command",
            "timeoutSeconds"
          ],
          "properties": {
            "command": {
              "type": "array",
              "items": {
                "type": "string",
                "maxLength": 4096
              },
              "minItems": 1,
              "maxItems": 64
            },
            "timeoutSeconds": {
              "type": "integer",
              "minimum": 1,
              "maximum": 3600
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "secrets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "as"
        ],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z0-9-]{1,40}$"
          },
          "as": {
            "anyOf": [
              {
                "type": "object",
                "required": [
                  "file"
                ],
                "properties": {
                  "file": {
                    "type": "string",
                    "pattern": "^[a-z0-9._-]{1,60}$"
                  }
                },
                "additionalProperties": false
              },
              {
                "type": "object",
                "required": [
                  "env"
                ],
                "properties": {
                  "env": {
                    "type": "string",
                    "pattern": "^[A-Z_][A-Z0-9_]{0,63}$"
                  }
                },
                "additionalProperties": false
              }
            ]
          },
          "optional": {
            "type": "boolean"
          }
        },
        "additionalProperties": false
      },
      "maxItems": 32
    },
    "jail": {
      "type": "object",
      "properties": {
        "readOnlyPaths": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "maxItems": 32
        },
        "writablePaths": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "maxItems": 32
        },
        "hidePaths": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "maxItems": 32
        }
      },
      "additionalProperties": false
    },
    "ports": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 1,
        "maximum": 65535
      },
      "maxItems": 8
    }
  },
  "additionalProperties": false
}
