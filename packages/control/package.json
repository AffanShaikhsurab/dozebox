{
  "name": "@dozebox/control",
  "version": "0.0.0",
  "private": true,
  "description": "The control function (AWS Lambda).",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24.12"
  },
  "sideEffects": false,
  "exports": {
    "./handler": {
      "@dozebox/source": "./src/handler.ts",
      "default": "./dist/control.mjs"
    },
    "./ports/*": {
      "@dozebox/source": "./src/ports/*.ts",
      "types": "./dist/ports/*.d.ts",
      "default": "./dist/ports/*.js"
    }
  },
  "scripts": {
    "build": "node scripts/build.ts",
    "test": "node --conditions=@dozebox/source --test \"test/*.test.ts\"",
    "test:wire": "node --conditions=@dozebox/source --test --test-concurrency=1 \"test/wire/*.test.ts\""
  },
  "dependencies": {
    "@aws-sdk/client-auto-scaling": "3.1176.0",
    "@aws-sdk/client-budgets": "3.1176.0",
    "@aws-sdk/client-dynamodb": "3.1176.0",
    "@aws-sdk/client-ec2": "3.1176.0",
    "@aws-sdk/client-sns": "3.1176.0",
    "@aws-sdk/client-ssm": "3.1176.0",
    "@dozebox/core": "workspace:*",
    "@dozebox/protocol": "workspace:*",
    "typebox": "1.4.7"
  },
  "devDependencies": {
    "@dozebox/testkit": "workspace:*",
    "esbuild": "0.28.2"
  }
}
