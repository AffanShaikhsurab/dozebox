{
  "name": "@dozebox/testkit",
  "version": "0.0.0",
  "private": true,
  "description": "Fakes, contract suites and fixtures for tests.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24.12"
  },
  "sideEffects": false,
  "exports": {
    "./fakes": {
      "@dozebox/source": "./src/fakes/index.ts",
      "types": "./dist/fakes/index.d.ts",
      "default": "./dist/fakes/index.js"
    },
    "./contracts": {
      "@dozebox/source": "./src/contracts/index.ts",
      "types": "./dist/contracts/index.d.ts",
      "default": "./dist/contracts/index.js"
    },
    "./wire": {
      "@dozebox/source": "./src/wire/index.ts",
      "types": "./dist/wire/index.d.ts",
      "default": "./dist/wire/index.js"
    },
    "./fixtures/*": "./fixtures/*"
  },
  "scripts": {
    "test": "node --conditions=@dozebox/source --test \"test/**/*.test.ts\""
  },
  "dependencies": {
    "@dozebox/core": "workspace:*",
    "memfs": "4.80.1"
  },
  "devDependencies": {
    "@dozebox/agent": "workspace:*",
    "@dozebox/client": "workspace:*",
    "@dozebox/control": "workspace:*",
    "dozebox": "workspace:*"
  }
}
