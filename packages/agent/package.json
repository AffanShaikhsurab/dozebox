{
  "name": "@dozebox/agent",
  "version": "0.0.0",
  "private": true,
  "description": "The box agent (dozeboxd).",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24.12"
  },
  "sideEffects": false,
  "bin": {
    "dozeboxd": "./dist/main.js",
    "dozebox-boot": "./dist/boot/main.js",
    "dozebox-shim": "./dist/bin/dozebox.js",
    "dozebox-jail-exec": "./dist/bin/jail-exec.js",
    "dozebox-tripwire": "./dist/bin/tripwire.js"
  },
  "exports": {
    "./main": {
      "@dozebox/source": "./src/main.ts",
      "types": "./dist/main.d.ts",
      "default": "./dist/main.js"
    },
    "./boot": {
      "@dozebox/source": "./src/boot/main.ts",
      "types": "./dist/boot/main.d.ts",
      "default": "./dist/boot/main.js"
    },
    "./bin/*": {
      "@dozebox/source": "./src/bin/*.ts",
      "types": "./dist/bin/*.d.ts",
      "default": "./dist/bin/*.js"
    },
    "./ports/*": {
      "@dozebox/source": "./src/ports/*.ts",
      "types": "./dist/ports/*.d.ts",
      "default": "./dist/ports/*.js"
    }
  },
  "scripts": {
    "build": "node scripts/build.ts",
    "test": "node --conditions=@dozebox/source --test \"test/*.test.ts\"",
    "test:systemd": "node --conditions=@dozebox/source --test \"test/systemd/*.test.ts\"",
    "test:wire": "node --conditions=@dozebox/source --test --test-concurrency=1 \"test/wire/*.test.ts\""
  },
  "dependencies": {
    "@aws-sdk/client-auto-scaling": "3.1176.0",
    "@aws-sdk/client-cloudwatch-logs": "3.1176.0",
    "@aws-sdk/client-ec2": "3.1176.0",
    "@aws-sdk/client-sns": "3.1176.0",
    "@aws-sdk/client-ssm": "3.1176.0",
    "@dozebox/core": "workspace:*",
    "@dozebox/protocol": "workspace:*"
  },
  "devDependencies": {
    "@dozebox/testkit": "workspace:*",
    "esbuild": "0.28.2"
  }
}
