{
  "name": "@dozebox/client",
  "version": "0.0.0",
  "private": true,
  "description": "Node client for payloads on a dozebox box.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24.12"
  },
  "sideEffects": false,
  "exports": {
    ".": {
      "@dozebox/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "test": "node --conditions=@dozebox/source --test \"test/*.test.ts\""
  },
  "dependencies": {
    "@dozebox/protocol": "workspace:*"
  }
}
