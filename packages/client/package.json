{
  "name": "@dozebox/client",
  "version": "0.0.0",
  "description": "Node client for payloads on a dozebox box.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24.12"
  },
  "sideEffects": false,
  "exports": {
    ".": {
      "@dozebox/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "test": "node --conditions=@dozebox/source --test \"test/*.test.ts\"",
    "build": "tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "@dozebox/protocol": "workspace:*"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AffanShaikhsurab/dozebox.git",
    "directory": "packages/client"
  },
  "homepage": "https://github.com/AffanShaikhsurab/dozebox#readme",
  "bugs": {
    "url": "https://github.com/AffanShaikhsurab/dozebox/issues"
  },
  "keywords": [
    "dozebox",
    "client",
    "sandbox",
    "ec2"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "files": [
    "dist",
    "README.md"
  ]
}
