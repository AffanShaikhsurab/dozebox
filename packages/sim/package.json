{
  "name": "@dozebox/sim",
  "version": "0.0.0",
  "private": true,
  "description": "Simulator, invariants, known classes and judge.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24.12"
  },
  "sideEffects": false,
  "exports": {
    ".": {
      "@dozebox/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "test": "node --conditions=@dozebox/source --test \"test/*.test.ts\"",
    "sim": "node --conditions=@dozebox/source scripts/sim.ts",
    "sim:judge": "node --conditions=@dozebox/source scripts/judge.ts"
  },
  "dependencies": {
    "@dozebox/core": "workspace:*"
  }
}
